{
  "name": "@morph-l2/sdk",
  "version": "0.3.30",
  "description": "[Morph] Tools for working with Morph",
  "main": "dist/index",
  "types": "dist/index",
  "files": [
    "dist/*",
    "src/*"
  ],
  "keywords": [
    "sdk"
  ],
  "license": "MIT",
  "devDependencies": {
    "@ethersproject/abstract-provider": "^5.7.0",
    "@ethersproject/abstract-signer": "^5.7.0",
    "@ethersproject/transactions": "^5.7.0",
    "@nomiclabs/hardhat-ethers": "^2.0.2",
    "@nomiclabs/hardhat-waffle": "^2.0.1",
    "chai-as-promised": "^7.1.1",
    "dayjs": "^1.11.9",
    "ethereum-waffle": "^3.4.0",
    "ethers": "^5.7.0",
    "glob": "^7.1.6",
    "hardhat": "^2.9.6",
    "hardhat-deploy": "^0.11.4",
    "isomorphic-fetch": "^3.0.0",
    "mocha": "^10.0.0",
    "nyc": "^15.1.0",
    "prettier-plugin-solidity": "^1.0.0-beta.13",
    "ts-node": "^10.9.1",
    "typedoc": "^0.25.13",
    "typedoc-plugin-markdown": "^4.0.1",
    "viem": "^0.3.30",
    "vitest": "^0.28.3",
    "zod": "^3.11.6"
  },
  "dependencies": {
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/bignumber": "^5.7.0",
    "@ethersproject/bytes": "^5.7.0",
    "@ethersproject/keccak256": "^5.7.0",
    "@morph-l2/contracts": "0.0.9",
    "axios": "^1.4.0",
    "chai": "^5.1.1",
    "lodash": "^4.17.21",
    "rlp": "^2.2.7",
    "scheduler": "^0.23.2",
    "typescript": "5.0.4"
  },
  "peerDependencies": {
    "ethers": "^5"
  },
  "scripts": {
    "all": "yarn clean && yarn build && yarn build:doc",
    "build": "tsc -p tsconfig.json",
    "build:doc": "typedoc src/index.ts",
    "clean": "rm -rf ./abi ./dist ./artifacts ./cache ./typechain-types ./logs ./tsconfig.tsbuildinfo ./docs",
    "lint": "yarn lint:fix && yarn lint:check",
    "lint:check": "eslint . --max-warnings=0",
    "lint:fix": "yarn lint:check --fix",
    "pre-commit": "lint-staged",
    "test": "hardhat test",
    "test:next": "vitest",
    "test:next:run": "vitest run",
    "test:coverage": "nyc hardhat test && nyc merge .nyc_output coverage.json",
    "autogen:docs": "typedoc --out docs src/index.ts",
    "autogen:artifacts": "ts-node tasks/generate-artifacts.ts"
  }
}