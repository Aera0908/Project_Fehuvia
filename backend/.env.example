# Port configuration
PORT=3001

# Supabase PostgreSQL Connection String (Session Pooler - IPv4 compatible)
# Go to: Supabase Dashboard > Settings > Database > Connection string > Session Pooler
# The direct connection (db.xxx.supabase.co) is IPv6-only and won't work on most local networks.
# Session Pooler format: postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# OpenAI API Key
OPENAI_API_KEY="sk-proj-..."

# Morph L2 Testnet Configuration
MORPH_TESTNET_RPC="https://rpc-hoodi.morph.network"

# The deployed B2BSettlement contract address from Phase 1
# Update this with your actual contract address once deployed on Morph L2
SETTLEMENT_CONTRACT_ADDRESS="0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512"

# JSON Web Token Secret for signing user sessions
JWT_SECRET="your-jwt-secret-key-here"

# Main vault private key for gas dispensing to connected wallets
# Do NOT prefix with 0x. Must have sufficient Morph testnet ETH.
PRIVATE_KEY="your-private-key-without-0x-prefix"

# Deployed mUSDC token contract address on Morph Testnet
USDC_CONTRACT_ADDRESS="0xD8FCA101505D9F698485B22dCC79dF2Ec7a24660"

# The public Vercel URL of the frontend (used for CORS allowlist)
# Set this to your deployed Vercel URL e.g. https://fehuvia.vercel.app
FRONTEND_URL="https://your-app.vercel.app"
